# Living Ambient Engine - Environment Configuration
# Copy this file to .env and fill in your values

# YouTube API (for upload automation - Milestone 2)
# YOUTUBE_CLIENT_ID=your_client_id_here
# YOUTUBE_CLIENT_SECRET=your_client_secret_here
# YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

# Output settings
OUTPUT_DIR=./output
ARTIFACTS_DIR=./artifacts

# Rendering settings
DEFAULT_FPS=30
DEFAULT_RESOLUTION=1920x1080
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
VIDEO_BITRATE=5000k

# Audio settings
SAMPLE_RATE=44100
AUDIO_CHANNELS=2

# Logging
LOG_LEVEL=INFO

