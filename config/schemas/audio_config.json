{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterkrentel/living-ambient-engine/config/schemas/audio_config.json",
  "title": "Audio Configuration",
  "description": "Schema for audio generator configuration. See docs/spec/GUARDRAILS.md for limits.",
  "type": "object",
  "required": ["tempo"],
  "properties": {
    "tempo": {
      "type": "integer",
      "minimum": 20,
      "maximum": 200,
      "default": 60,
      "description": "Base BPM for rhythm and melody timing"
    },
    "binaural_freq": {
      "type": "number",
      "minimum": 1,
      "maximum": 50,
      "default": 10,
      "description": "Brainwave entrainment frequency in Hz (1=Delta, 10=Alpha, 40=Gamma)"
    },
    "sine_freq": {
      "type": "integer",
      "enum": [174, 285, 396, 417, 432, 528, 639, 741, 852, 963],
      "default": 432,
      "description": "Solfeggio frequency in Hz"
    },
    "rhythm_pattern": {
      "type": "string",
      "enum": ["gnawa", "bamboula", "tarantella", "sufi", "candombe", "tribal", "none"],
      "default": "gnawa",
      "description": "Tribal rhythm pattern name"
    },
    "rhythm_volume": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.5,
      "description": "Volume level for rhythm layer"
    },
    "drone_volume": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 1.0,
      "description": "Volume multiplier for drone/tonal layers"
    },
    "melody_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable melodic elements"
    },
    "arpeggio_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable arpeggio patterns"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["sine", "binaural", "pink_noise", "white_noise", "melody", "arpeggio"]
          },
          "frequency": {
            "type": "number",
            "minimum": 20,
            "maximum": 20000
          },
          "volume": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      },
      "description": "Audio layer definitions"
    }
  },
  "additionalProperties": true
}

